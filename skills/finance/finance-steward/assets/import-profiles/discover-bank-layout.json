{
  "name": "discover-bank-layout-example-v1",
  "currency": "USD",
  "sign_mode": "as-is",
  "section_markers": [
    {
      "pattern": "deposits (?:and|&) (?:other )?credits",
      "sign_mode": "as-is"
    },
    {
      "pattern": "electronic withdrawals|checks paid|withdrawals|debits",
      "sign_mode": "invert"
    }
  ],
  "line_pattern": "^\\s*[A-Za-z]{3}\\s+\\d{1,2}\\s+(?P<date>[A-Za-z]{3}\\s+\\d{1,2})\\s+(?P<description>.+?)\\s+\\$?(?P<amount>[0-9,]+\\.\\d{2})\\s*$"
}
